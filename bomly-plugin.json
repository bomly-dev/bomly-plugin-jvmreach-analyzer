{
  "schemaVersion": "bomly.plugin.package.v1",
  "id": "jvmreach",
  "name": "jvmreach Reachability Analyzer",
  "version": "0.2.0",
  "kind": "analyzer",
  "runtime": "hashicorp-grpc",
  "pluginApiVersion": "bomly.plugin.v1",
  "entrypoint": {
    "linux/amd64": "bomly-plugin-jvmreach-analyzer",
    "linux/arm64": "bomly-plugin-jvmreach-analyzer",
    "darwin/amd64": "bomly-plugin-jvmreach-analyzer",
    "darwin/arm64": "bomly-plugin-jvmreach-analyzer",
    "windows/amd64": "bomly-plugin-jvmreach-analyzer.exe"
  },
  "description": "JVM reachability analyzer for Bomly: scans Java/Kotlin/Scala sources in Maven, Gradle, and sbt projects to mark which vulnerable artifacts are actually imported (package tier).",
  "homepage": "https://github.com/bomly-dev/bomly-plugin-jvmreach-analyzer",
  "license": "Apache-2.0"
}
